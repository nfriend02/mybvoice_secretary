rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasStatus() {
      return request.resource.data.keys().hasAll(['status'])
        && request.resource.data.status is string;
    }

    match /messages/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /summaries/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /documents/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /uploads/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /schedules/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /drafts/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /translations/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /workflows/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /study_cards/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }

    match /live_queries/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }
  }
}
